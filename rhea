<style>
  :root{
    --bg: #0d1117;
    --surface: #141b24;
    --surface-2: #1b2430;
    --line: #26303c;
    --line-soft: #1c2530;
    --text: #f1ede3;
    --text-muted: #97a1b0;
    --mint: #6fe3b4;
    --mint-dim: #204838;
    --coral: #ff8b5e;
    --coral-dim: #5c3626;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto;} *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;} }
  body{
    background:var(--bg); color:var(--text); font-family:'IBM Plex Sans', sans-serif;
    line-height:1.65; -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  body.locked{overflow:hidden;}
  ::selection{background:var(--coral); color:#0d1117;}
  a{color:inherit;}
  h1,h2,h3{font-family:'Fraunces', serif; font-weight:600; letter-spacing:-0.01em;}
  .mono{font-family:'IBM Plex Mono', monospace;}
  .wrap{max-width:980px; margin:0 auto; padding:0 32px;}

  /* NAV */
  nav{
    position:sticky; top:0; z-index:40; backdrop-filter: blur(10px);
    background:rgba(13,17,23,0.72); border-bottom:1px solid var(--line-soft);
  }
  .nav-inner{max-width:980px; margin:0 auto; padding:18px 32px; display:flex; justify-content:space-between; align-items:center;}
  .nav-name{font-family:'Fraunces'; font-weight:600; font-size:17px;}
  .nav-name .dot{color:var(--mint);}
  .nav-links{display:flex; gap:28px; font-family:'IBM Plex Mono'; font-size:12.5px; letter-spacing:0.04em;}
  .nav-links a{text-decoration:none; color:var(--text-muted); transition:color 0.15s;}
  .nav-links a:hover{color:var(--mint);}
  @media(max-width:600px){.nav-links{display:none;}}

  /* HERO */
  .hero{padding:96px 0 70px; position:relative; border-bottom:1px solid var(--line);}
  .pulse-bg{position:absolute; left:0; right:0; top:38%; width:100%; height:120px; pointer-events:none; opacity:0.35;}
  .pulse-bg path{
    stroke:var(--mint); stroke-width:1.4; fill:none;
    stroke-dasharray:900; stroke-dashoffset:900;
    animation: draw 2.2s 0.2s cubic-bezier(.3,.7,.3,1) forwards;
  }
  @keyframes draw{ to{stroke-dashoffset:0;} }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.16em; text-transform:uppercase;
    color:var(--coral); margin-bottom:22px; display:flex; align-items:center; gap:10px; position:relative; z-index:2;
  }
  .eyebrow::before{content:''; width:7px; height:7px; border-radius:50%; background:var(--coral); box-shadow:0 0 0 4px var(--coral-dim);}
  .hero h1{font-size:clamp(36px, 6vw, 60px); line-height:1.08; max-width:780px; color:#fff; position:relative; z-index:2;}
  .hero h1 em{font-style:italic; color:var(--mint); font-weight:500;}
  .hero p.sub{margin-top:24px; font-size:18.5px; color:var(--text-muted); max-width:580px; position:relative; z-index:2;}

  .vitals{display:flex; gap:0; margin-top:52px; border-top:1px solid var(--line); position:relative; z-index:2;}
  .vital{flex:1; padding:20px 24px 0 0; border-right:1px solid var(--line);}
  .vital:last-child{border-right:none;}
  .vital:first-child{padding-left:0;}
  .vital .num{font-family:'Fraunces'; font-size:26px; color:#fff; font-weight:600;}
  .vital .cap{font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--text-muted); margin-top:4px;}
  @media(max-width:640px){.vitals{flex-wrap:wrap;} .vital{flex:1 1 45%; border-right:none; margin-bottom:16px;}}

  /* PILLARS */
  .pillars{padding:64px 0; border-bottom:1px solid var(--line);}
  .pillar-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden;}
  @media(max-width:720px){.pillar-grid{grid-template-columns:1fr;}}
  .pillar{background:var(--surface); padding:30px;}
  .pillar .glyph{width:36px; height:36px; margin-bottom:20px;}
  .pillar h3{font-size:18px; color:#fff; margin-bottom:10px; font-weight:600;}
  .pillar p{font-size:14px; color:var(--text-muted);}

  /* PULLQUOTE */
  .pullquote{padding:80px 0; border-bottom:1px solid var(--line); position:relative;}
  .pullquote .mark{font-family:'Fraunces'; font-size:72px; color:var(--coral-dim); line-height:0.6; position:absolute; top:64px; left:32px;}
  .pullquote p{font-family:'Fraunces'; font-style:italic; font-weight:500; font-size:clamp(22px,3vw,30px); line-height:1.5; max-width:720px; color:#fff; padding-left:8px;}
  .pullquote p + p{margin-top:22px; font-family:'IBM Plex Sans'; font-style:normal; font-weight:400; font-size:16px; color:var(--text-muted); max-width:640px;}

  /* PROOF OF WORK */
  .section{padding:70px 0; border-bottom:1px solid var(--line);}
  .section-head{display:flex; align-items:baseline; justify-content:space-between; margin-bottom:40px; flex-wrap:wrap; gap:8px;}
  .section-head h2{font-size:30px; color:#fff;}
  .section-head .count{font-family:'IBM Plex Mono'; font-size:13px; color:var(--text-muted);}

  .grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  @media(max-width:720px){.grid{grid-template-columns:1fr;}}

  .card{
    background:var(--surface); border:1px solid var(--line); border-radius:12px; overflow:hidden;
    cursor:pointer; transition: border-color 0.22s, transform 0.22s, box-shadow 0.22s; text-align:left; width:100%;
    font-family:inherit; color:inherit; display:block;
  }
  .card:hover{border-color:var(--mint); transform:translateY(-3px); box-shadow:0 16px 40px -20px rgba(0,0,0,0.6);}
  .card:focus-visible{outline:2px solid var(--mint); outline-offset:2px;}

  .thumb{
    position:relative; height:150px;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size:15px 15px;
    background-color: var(--surface-2);
    display:flex; align-items:center; justify-content:center;
  }
  .thumb svg{width:96px; height:96px; opacity:0.95;}
  .thumb .view{
    position:absolute; inset:0; background:rgba(13,17,23,0.72); display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.06em; color:var(--mint); opacity:0; transition:opacity 0.2s;
  }
  .card:hover .view{opacity:1;}

  .card-body{padding:22px 24px 26px;}
  .card .tag{
    display:inline-block; font-family:'IBM Plex Mono'; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--coral); border:1px solid var(--coral-dim); padding:3px 9px; border-radius:20px; margin-bottom:14px;
  }
  .card h3{font-size:18px; color:#fff; margin-bottom:4px; font-weight:600;}
  .card .meta{font-size:12.5px; color:var(--text-muted); font-family:'IBM Plex Mono'; margin-bottom:10px;}
  .card p{font-size:14px; color:#c3c9d2;}

  /* EDUCATION */
  .edu-list{list-style:none;}
  .edu-list li{display:flex; justify-content:space-between; gap:20px; padding:18px 0; border-bottom:1px solid var(--line); flex-wrap:wrap;}
  .edu-list li:last-child{border-bottom:none;}
  .edu-list .name{font-family:'Fraunces'; font-weight:600; color:#fff; font-size:17px;}
  .edu-list .detail{font-size:13.5px; color:var(--text-muted); margin-top:3px;}
  .edu-list .when{font-family:'IBM Plex Mono'; font-size:12.5px; color:var(--text-muted); white-space:nowrap;}

  /* SKILLS */
  .skills-grid{display:flex; flex-wrap:wrap; gap:10px;}
  .skill{font-family:'IBM Plex Mono'; font-size:13px; padding:9px 15px; border-radius:7px; background:var(--surface-2); border:1px solid var(--line); color:var(--text);}
  .skill.core{border-color:var(--mint); color:var(--mint);}

  footer{padding:60px 0 84px; text-align:center;}
  footer h2{font-size:28px; color:#fff; margin-bottom:12px;}
  footer p{color:var(--text-muted); font-size:15px; margin-bottom:26px;}
  .contact-row{display:flex; justify-content:center; gap:22px; flex-wrap:wrap; font-family:'IBM Plex Mono'; font-size:13.5px;}
  .contact-row a{color:var(--coral); text-decoration:none; border-bottom:1px solid var(--coral-dim); padding-bottom:2px;}
  .contact-row a:hover{border-color:var(--coral);}

  /* MODAL */
  .overlay{
    position:fixed; inset:0; background:rgba(8,10,14,0.82); backdrop-filter:blur(6px);
    z-index:100; display:none; align-items:flex-start; justify-content:center; padding:48px 20px; overflow-y:auto;
  }
  .overlay.open{display:flex;}
  .modal{
    background:var(--surface); border:1px solid var(--line); border-radius:16px; max-width:720px; width:100%;
    padding:40px; position:relative; animation: modalIn 0.28s cubic-bezier(.2,.8,.2,1);
  }
  @keyframes modalIn{ from{opacity:0; transform:translateY(14px) scale(0.98);} to{opacity:1; transform:none;} }
  .modal-close{
    position:absolute; top:22px; right:22px; width:34px; height:34px; border-radius:50%;
    background:var(--surface-2); border:1px solid var(--line); color:var(--text-muted); cursor:pointer;
    font-size:18px; display:flex; align-items:center; justify-content:center; transition:color 0.15s, border-color 0.15s;
  }
  .modal-close:hover{color:var(--mint); border-color:var(--mint);}
  .modal .tag{display:inline-block; font-family:'IBM Plex Mono'; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--coral); border:1px solid var(--coral-dim); padding:3px 9px; border-radius:20px; margin-bottom:16px;}
  .modal h2{font-size:28px; color:#fff; margin-bottom:6px;}
  .modal .meta{font-family:'IBM Plex Mono'; font-size:12.5px; color:var(--text-muted); margin-bottom:22px;}
  .modal .desc{font-size:15.5px; color:#c9cfd8; margin-bottom:28px;}
  .modal .stack{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:34px;}
  .modal .stack span{font-family:'IBM Plex Mono'; font-size:11px; color:var(--mint); background:var(--mint-dim); border:1px solid #2c5b47; padding:3px 9px; border-radius:5px;}

  .modal-label{font-family:'IBM Plex Mono'; font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--text-muted); margin-bottom:12px; display:block;}

  .modal-banner{
    height:150px; border-radius:10px; margin-bottom:28px;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size:15px 15px; background-color:var(--surface-2);
    display:flex; align-items:center; justify-content:center;
  }
  .modal-banner svg{width:110px; height:110px;}

  .gallery{display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:30px;}
  @media(max-width:520px){.gallery{grid-template-columns:1fr 1fr;}}
  .gallery img{width:100%; aspect-ratio:1; object-fit:cover; border-radius:9px; border:1px solid var(--line);}
</style>
